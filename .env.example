# Пример конфигурации. Скопируйте в .env и заполните СВОИМИ значениями.
# Файл .env добавлен в .gitignore и не должен попадать в репозиторий (14.5.2 ТЗ).
# Для dev/staging/production используйте РАЗНЫЕ значения секретов (14.5, п. 2).

# --- PostgreSQL ---
POSTGRES_DB=effecom
POSTGRES_USER=effecom
# Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Backend ---
# Ключ подписи JWT. Сгенерируйте: openssl rand -hex 32
SECRET_KEY=
# Сессия истекает после стольких минут НЕАКТИВНОСТИ
# (при работе токен продлевается автоматически)
ACCESS_TOKEN_MINUTES=60
# Абсолютный предел сессии в часах — после него нужен повторный вход
SESSION_MAX_HOURS=12
# CORS allowlist через запятую. Никогда не используйте "*".
# Для production укажите домен: https://content.effecom.ru
CORS_ORIGINS=http://localhost
# development | production (в production скрывается /api/docs)
ENVIRONMENT=development

# --- Первичный администратор (создаётся один раз при пустой базе) ---
ADMIN_EMAIL=admin@effecom.ru
# Минимум 10 символов. После первого входа смените через интерфейс.
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# --- Порт, на котором наружу доступна панель ---
APP_PORT=80

# --- AI-генерация (Этап 3; разделы 6.6-6.9 и 14.11 ТЗ) ---
# Провайдер: "openai" (и любой OpenAI-совместимый API) или "anthropic".
# Пусто = AI выключен: сервис работает, AI-кнопки сообщают «AI не настроен».
AI_PROVIDER=
# Ключ ТОЛЬКО здесь — в коде, БД и интерфейсе он не хранится и не показывается
AI_API_KEY=
# Модель, например: gpt-4o-mini / claude-sonnet-4-5
AI_MODEL=
# Для OpenAI-совместимых шлюзов (пусто = https://api.openai.com)
AI_BASE_URL=
# Таймаут одного AI-запроса, сек (обязателен; nginx для /api/ai/ держит 180s)
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4000
# Лимиты стоимости (14.11.7): при достижении запросы приостанавливаются. 0 = без лимита
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50
# Цены модели за 1M токенов, USD — ОБЯЗАТЕЛЬНО заполните реальными ценами
# выбранной модели (страница цен провайдера). При нулях расход считается
# как $0, и бюджетные лимиты выше фактически не срабатывают.
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0

# --- Мониторинг источников (Этап 4a; 6.1-6.2 и 14.7 ТЗ) ---
# По умолчанию ВЫКЛЮЧЕН: worker запущен, но ничего не парсит.
# Включение: MONITOR_ENABLED=true и перезапуск worker.
MONITOR_ENABLED=false
# Как часто воркер просыпается проверить расписание, сек
MONITOR_TICK_SECONDS=300
# Таймаут одного HTTP-запроса к источнику, сек (обязателен)
MONITOR_HTTP_TIMEOUT=20
# Максимум новых материалов, сохраняемых за один прогон источника
MONITOR_MAX_ITEMS_PER_RUN=30
